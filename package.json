{
  "name": "sentinel-app",
  "version": "5.0.0",
  "description": "Sentinel Kiosk & Backoffice System for Raspberry Pi 5",
  "main": "src/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "hash": "./sentinel password",
    "check": "node -e \"['src/server.js','src/auth.js','src/streams.js','src/events.js','src/system.js','src/devices.js','src/sockets.js','src/config.js','src/cameras.js'].forEach(f=>{new (require('vm').Script)(require('fs').readFileSync(f,'utf8'),{filename:f});console.log('OK',f)})\""
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "socket.io": "^4.8.1",
    "ws": "^8.18.0"
  }
}
